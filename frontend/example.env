# Skapp Core (community) frontend
# Copy to frontend/.env and fill in the values. Never commit the real .env.

# Backend base URL, without /v1 (the app adds the API version itself)
NEXT_PUBLIC_API_URL=http://localhost:8008

# App edition: community for Core
NEXT_PUBLIC_MODE=community
APP_MODE=community

# A random string used to hash tokens, sign cookies and generate cryptographic keys
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<random-string>

# The URL of this Next.js app, used by NextAuth for redirects (defaults to localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Optional: Google Maps key for the geofence map in configurations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: analytics, leave empty to disable
GOOGLE_ANALYTICS_GTM_ID=
FACEBOOK_PIXEL_ID=
HOTJAR_ID=
