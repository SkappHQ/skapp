# Skapp Core (community) frontend
# Copy to frontend/.env and fill in the values. Never commit the real .env.
# NEXT_PUBLIC_* values are baked into the bundle at `next build`.
# Changing them in a runtime .env or container env has no effect until you rebuild.

# Backend base URL, without /v1 (the app adds the API version itself)
NEXT_PUBLIC_API_URL=http://localhost:8008

# App edition: community for Core
NEXT_PUBLIC_MODE=community

# Optional: Google Maps key for the geofence map in configurations
# This key is sent to every browser, so restrict it by HTTP referrer in Google Cloud
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: analytics IDs
# Note: the Hotjar, Meta Pixel and GTM noscript tags are still added to every page
# when these are empty, so leaving them blank does not fully disable them
GOOGLE_ANALYTICS_GTM_ID=
FACEBOOK_PIXEL_ID=
HOTJAR_ID=
