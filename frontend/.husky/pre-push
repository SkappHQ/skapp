frontend_dir=$(dirname "$(cd "$(dirname "$0")" && pwd)")
repo_dir=$(cd "$(git rev-parse --show-toplevel)" && pwd)

pushed_files() {
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    base=$remote_sha
    git cat-file -e "$base^{commit}" 2>/dev/null || base=$(git merge-base "$local_sha" refs/remotes/origin/develop 2>/dev/null || true)
    if [ -n "$base" ]; then
      git -c core.quotePath=false diff --name-only --diff-filter=d "$base" "$local_sha"
    else
      echo "pre-push: no base commit found for $remote_ref, type check skipped" >&2
    fi
  done
}

pushed_typescript() {
  pushed_files | while read -r file; do
    path=$repo_dir/$file
    case "$path" in
      "$frontend_dir"/*.ts | "$frontend_dir"/*.tsx) printf '%s(\n' "${path#"$frontend_dir"/}" ;;
    esac
  done
}

check_pushed_files() {
  output=$(cd "$1" && npx --no-install tsc --noEmit --pretty false 2>&1) && return 0
  errors=$(printf '%s\n' "$output" | awk -v patterns="$2" '
    BEGIN { count = split(patterns, pattern, "\n") }
    /^[ \t]/ { if (keep) print; next }
    {
      keep = index($0, "error TS") == 1 || $0 ~ /^[^ (]*\.json\(/
      for (i = 1; i <= count && !keep; i++) keep = index($0, pattern[i]) == 1
      if (keep) print
    }')
  case "$output" in
    *"error TS"*) ;;
    *) errors=$output ;;
  esac
  if [ -n "$errors" ]; then
    echo "pre-push: type errors in files this push changes" >&2
    printf '%s\n' "$errors" >&2
    return 1
  fi
}

patterns=$(pushed_typescript)

if [ -n "$patterns" ]; then
  check_pushed_files "$frontend_dir" "$patterns" || exit 1
fi
