{
  "endOfLine": "auto",
  "printWidth": 80,
  "tabWidth": 2,
  "trailingComma": "none",
  "singleQuote": false,
  "semi": true,
  "importOrder": [
    "^~(.*)$",
    "^~community/(.*)$",
    "^~enterprise/(.*)$",
    "^~public/(.*)$",
    "^~styles/(.*)$",
    "^~i18n/(.*)$",
    "^[./]",
    "^~proxy/(.*)$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "tailwindStylesheet": "./styles/global.css",
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ]
}
