# Skapp Core (community) backend
# Copy to backend/.env and fill in the values. Never commit the real .env.
# Spring Boot does not read .env files by itself. Load it into your shell before starting:
#   set -a; source .env; set +a; mvn spring-boot:run
# or point your IDE run configuration at this file (e.g. IntelliJ EnvFile).

# Spring profile: non-prd for local/dev, prd for production
SPRING_PROFILES_ACTIVE=non-prd

# MySQL database (created on first run if it does not exist)
# Use a dedicated least-privilege user, not root, outside local development
DB_URL=jdbc:mysql://localhost:3306/skapp-dev?createDatabaseIfNotExist=true
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Cookie domain for the refresh-token cookie
# Bare host only: no scheme, port or path (e.g. example.com, not https://app.example.com:3000)
# Must cover both the frontend and backend hosts, otherwise users are silently logged out
# Required in prd (non-prd defaults to localhost)
DOMAIN_BASE=localhost

# JWT signing key: must be Base64 and decode to at least 32 bytes
# Changing it invalidates every issued token, so all users have to sign in again
# Generate with: openssl rand -base64 32
SIGN_IN_KEY=<base64-32-byte-key>

# Key for encrypting uploaded files (any random string, it is hashed with SHA-256)
# WARNING: do not change after first run, existing encrypted files become unreadable
# Generate with: openssl rand -hex 32
FILE_ENCRYPT_KEY=<random-string>

# Key for encrypting stored values (any random string, it is hashed with SHA-256)
# WARNING: do not change after first run, existing encrypted values become unreadable
# Generate with: openssl rand -hex 32
ENCRYPT_DECRYPT_SECRET=<random-string>
